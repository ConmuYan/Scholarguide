# Default model selected for this project: DeepSeek Flash (Chat Completions API).
SG_PROVIDER=openai
SG_BASE_URL=https://api.deepseek.com
SG_MODEL=deepseek-flash
SG_API_KEY=YOUR-DEEPSEEK-KEY
# Optional on a machine where pi already holds this API key:
# SG_API_KEY=@pi:deepseek
SG_SOURCE=multi
# Optional CLI research path (Web Live enables it independently):
# SG_RESEARCH_MODE=false
# chat_completions (default) or responses
SG_PROTOCOL=chat_completions
# Optional price estimate; CNY per 1M tokens. Leave empty to show cost unknown.
# SG_INPUT_PRICE=
# SG_OUTPUT_PRICE=
# SG_CURRENCY=CNY
# Optional local profile store; defaults to ~/.scholarguide/providers.json
# SG_PROVIDER_STORE=
# langgraph (default) or legacy
SG_AGENT_RUNTIME=langgraph
SG_REQUEST_TIMEOUT=90
SG_SOURCE_TIMEOUT=15
SG_TASK_TIMEOUT=600
# Optional output cap for structured JSON; MiniMax M3.1 needs a higher value
SG_MAX_OUTPUT_TOKENS=3000
# Other OpenAI-compatible endpoints can replace base URL/model above.
# Optional local Ollama configuration:
# SG_PROVIDER=ollama
# SG_BASE_URL=http://localhost:11434
# SG_MODEL=YOUR-INSTALLED-MODEL
# SG_API_KEY=
# Optional HTTP proxy for source requests only (not model traffic):
# SG_SOURCE_PROXY=http://127.0.0.1:7890
# Optional multi-source keys (never commit real values):
# OPENALEX_API_KEY=
# S2_API_KEY=
# DEEPSEEK_SEARCH_KEY=
